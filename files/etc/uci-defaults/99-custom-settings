#!/bin/sh

# 1. تغيير عنوان IP الراوتر إلى 192.168.1.20
uci set network.lan.ipaddr='192.168.1.20'

# 2. إيقاف خدمة DHCP
uci set dhcp.lan.ignore='1'

# 3. إيقاف IPv6 و DHCPv6
uci set network.lan.ipv6='0'
uci set network.wan.ipv6='0'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ra='disabled'

# 4. إعدادات الواي فاي 2.4GHz (AX)
uci set wireless.radio0.disabled='0'
uci set wireless.radio0.channel='4'
uci set wireless.radio0.htmode='HE20'
uci set wireless.radio0.txpower='28'
uci set wireless.radio0.country='PA'
uci set wireless.default_radio0.ssid='ABDURAHEEM_2G'
uci set wireless.default_radio0.encryption='none'
uci set wireless.default_radio0.network='lan'
uci set wireless.default_radio0.mode='ap'

# 5. إعدادات الواي فاي 5GHz (AX + WDS)
uci set wireless.radio1.disabled='0'
uci set wireless.radio1.channel='116'
uci set wireless.radio1.htmode='HE40'
uci set wireless.radio1.txpower='28'
uci set wireless.radio1.country='PA'
uci set wireless.default_radio1.ssid='ABDURAHEEM_5G'
uci set wireless.default_radio1.encryption='none'
uci set wireless.default_radio1.network='lan'
uci set wireless.default_radio1.mode='ap'
uci set wireless.default_radio1.wds='1' # تفعيل WDS

# حفظ التغييرات وتطبيقها
uci commit
/etc/init.d/network restart
/etc/init.d/dnsmasq restart
wifi reload

exit 0
